<div class="auth-card">
  <h1 class="auth-card__title">Entrada</h1>
  
  <form class="form" id="login-form">
    <div class="form__field">
      <label class="form__label" for="login">Login</label>
      <input class="form__input" type="text" id="login" name="login" placeholder="Insert Username" required>
    </div>
    
    <div class="form__field">
      <label class="form__label" for="password">Password</label>
      <input class="form__input" type="password" id="password" name="password" placeholder="Insert Password" required>
    </div>

    <div class="auth-card__actions">
      <button class="btn btn--primary" type="submit">Iniciar sesión</button>
      <button class="btn btn--link" type="button" id="go-to-register">¿No tienes una cuenta?</button>
    </div>
  </form>
</div>