<div class="profile-layout">
  <aside class="profile-layout__back-panel" id="back-to-profile">
    <button class="profile-layout__back-btn">←</button>
  </aside>
  
  <main class="profile-layout__content">
    <form class="profile-layout__card" id="edit-password-form">
      <div class="profile-layout__avatar-wrapper">
        <div class="profile-layout__avatar">
           {{#if user.avatar}}
            <img src="{{user.avatar}}" alt="Avatar">
          {{else}}
            <span style="font-size: 40px;">👤</span>
          {{/if}}
        </div>
      </div>

      <div class="profile-layout__details">
        {{#each passwordFields}}
          <div class="profile-layout__field">
            <label class="profile-layout__label" for="{{name}}">{{label}}</label>
            <input class="profile-layout__value profile-layout__value--input" 
                   type="{{type}}" id="{{name}}" name="{{name}}" placeholder="{{placeholder}}" required>
          </div>
        {{/each}}
      </div>

      <button type="submit" class="btn btn--primary profile-layout__submit-btn">Guardar</button>
    </form>
  </main>
</div>