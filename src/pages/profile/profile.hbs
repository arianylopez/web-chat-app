<div class="profile-layout">
  <aside class="profile-layout__back-panel" id="back-to-chat">
    <button class="profile-layout__back-btn">←</button>
  </aside>
  
  <main class="profile-layout__content">
    <div class="profile-layout__card">
      <div class="profile-layout__avatar-wrapper">
        <div class="profile-layout__avatar">
          {{#if user.avatar}}
            <img src="{{user.avatar}}" alt="Avatar">
          {{else}}
            <span style="font-size: 40px;">👤</span>
          {{/if}}
        </div>
        <h2 class="profile-layout__name">{{user.first_name}}</h2>
      </div>

      <div class="profile-layout__details">
        {{#each fields}}
          <div class="profile-layout__field">
            <span class="profile-layout__label">{{label}}</span>
            <span class="profile-layout__value">{{value}}</span>
          </div>
        {{/each}}
      </div>

      <div class="profile-layout__actions">
        <button class="profile-layout__action-btn" id="go-to-edit-profile">Cambiar datos</button>
        <button class="profile-layout__action-btn" id="go-to-edit-password">Cambiar contraseña</button>
        <button class="profile-layout__action-btn profile-layout__action-btn--danger" id="logout">Salir</button>
      </div>
    </div>
  </main>
</div>